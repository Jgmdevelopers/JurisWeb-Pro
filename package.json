{
  "name": "jurisweb-pro",
  "version": "0.2.0-dev",
  "description": "Plantilla estática demostrativa para estudios jurídicos. Sin dependencias ni backend. Abrir index.html o ejecutar `python -m http.server 8000` y visitar http://localhost:8000.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:responsive": "playwright test responsive.spec.js",
    "test:navegacion": "playwright test navegacion.spec.js",
    "test:animaciones": "playwright test animaciones.spec.js",
    "test:contacto": "playwright test contacto.spec.js",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "serve:test": "http-server . -a 127.0.0.1 -p 8765 -c-1",
    "test:hero": "playwright test hero.spec.js",
    "test:encabezado": "playwright test encabezado.spec.js",
    "test:estudio": "playwright test estudio.spec.js",
    "test:areas": "playwright test areas.spec.js",
    "test:equipo": "playwright test equipo.spec.js",
    "test:consulta": "playwright test consulta.spec.js",
    "test:preguntas": "playwright test preguntas.spec.js",
    "test:contacto-premium": "playwright test contacto-premium.spec.js",
    "test:footer": "playwright test footer.spec.js",
    "test:identidad": "playwright test identidad.spec.js",
    "test:tema": "playwright test tema.spec.js",
    "generar:iconografia": "node scripts/generar-iconografia.mjs",
    "test:iconografia": "playwright test iconografia.spec.js",
    "test:editorial": "playwright test editorial.spec.js",
    "generar:seo": "node scripts/generar-seo.mjs",
    "validar:seo": "node scripts/generar-seo.mjs --check",
    "test:seo:unit": "node --test tests/unit/seo.test.mjs",
    "test:seo:e2e": "playwright test seo.spec.js",
    "test:seo": "npm run test:seo:unit && npm run test:seo:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jgmdevelopers/JurisWeb-Pro.git"
  },
  "keywords": [],
  "author": "GM.DEV",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Jgmdevelopers/JurisWeb-Pro/issues"
  },
  "homepage": "https://github.com/Jgmdevelopers/JurisWeb-Pro#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "http-server": "14.1.1"
  },
  "private": true
}
